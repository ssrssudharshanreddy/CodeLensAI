# CodeLens AI Configuration Template
# Copy this file to .env and customize as needed.

# Ollama local endpoint
CODELENS_OLLAMA_URL=http://127.0.0.1:11434

# Installed model name in Ollama
CODELENS_MODEL=gemma4:e2b

# Explicit workspace directory (defaults to current directory)
CODELENS_WORKSPACE=.

# Maximum autonomous loop iterations before bounded stop
CODELENS_MAX_ITERATIONS=8

# Timeout in seconds for LLM generation
CODELENS_LLM_TIMEOUT=90

# Timeout in seconds for sandbox execution of untrusted code/tests
CODELENS_SANDBOX_TIMEOUT=8

# Memory limit in MB for sandbox execution
CODELENS_SANDBOX_MEMORY_MB=256

# Auto-approve patches (0 = prompt user before modifying files, 1 = auto-approve)
CODELENS_AUTO_APPROVE=0

# Sandbox execution enabled (1 = enabled, 0 = disabled)
CODELENS_SANDBOX_ENABLED=1

# Verbose debug logging (1 = enabled, 0 = disabled)
CODELENS_VERBOSE=0
